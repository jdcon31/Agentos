# AgentOS (public excerpt) — configuration surface.
# Copy to .env. Every value below is read from the environment; secrets are
# never read from config.json and never committed.

# ── Frontier tier (Anthropic) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
FRONTIER_MODEL=claude-haiku-4-5
FRONTIER_VISION_MODEL=claude-sonnet-4-6

# ── Local tier (Ollama) ──────────────────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SECURE_COOKIES=true

# Session signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Hash of the single-operator app password (not the password itself).
APP_PASSWORD_HASH=

# ── Runtime ──────────────────────────────────────────────────────────────────
MAX_CONCURRENT_AGENTS=5
OUTPUT_PATH=
